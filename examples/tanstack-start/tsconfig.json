{
  "include": [
    "../../examples/tanstack-start/**/*.ts",
    "../../examples/tanstack-start/**/*.tsx"
  ],
  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "~/*": ["../../examples/tanstack-start/src/*"],
      "@ada/ui/*": ["../../packages/ui/src/*"]
    },
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
