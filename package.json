{
  "name": "ada",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "rimraf --glob \"examples/**/{node_modules,dist,.turbo}\" \"packages/**/{node_modules,dist,.turbo}\" \"node_modules\" \".turbo\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "lefthook": "catalog:",
    "portless": "catalog:",
    "rimraf": "^6.1.3",
    "turbo": "catalog:",
    "typescript": "^6.0.2",
    "ultracite": "^7.4.3"
  }
}
