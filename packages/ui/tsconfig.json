{
  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@ada/ui/*": ["./src/*"]
    },
    "lib": ["es2024", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
