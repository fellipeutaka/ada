{
  "$schema": "node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {},
    "test:e2e": { "cache": false, "passThroughEnv": ["DATABASE_URL"] }
  }
}
